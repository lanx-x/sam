{
  "kind": "collectionType",
  "collectionName": "ui_sections",
  "info": {
    "singularName": "ui-section",
    "pluralName": "ui-sections",
    "displayName": "UISection"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "desc": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "extra_images": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "actions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::action.action"
    },
    "data": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "item.common-item",
      "repeatable": true
    },
    "extension": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "item.kv-item",
      "repeatable": true
    },
    "renderer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::renderer.renderer"
    },
    "display_text": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "item.kv-item",
      "repeatable": true
    },
    "admin_note": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "unique": true
    },
    "dynamic": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "list.featured-story-list",
        "list.featured-spe-list",
        "list.featured-post-list",
        "list.featured-industry-list",
        "list.featured-faq-list",
        "list.featured-equipment-list",
        "list.featured-surface-finish-list"
      ]
    }
  }
}
