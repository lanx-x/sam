{
  "kind": "collectionType",
  "collectionName": "actions",
  "info": {
    "singularName": "action",
    "pluralName": "actions",
    "displayName": "Action"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "extension": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "item.kv-item",
      "repeatable": true
    },
    "admin_note": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "target_type": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "internal_page",
        "external_url",
        "popup"
      ]
    },
    "target_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "target_type"
            },
            "internal_page"
          ]
        }
      }
    },
    "target_url": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "target_type"
            },
            "external_url"
          ]
        }
      }
    }
  }
}
