{
  "collectionName": "components_item_common_items",
  "info": {
    "displayName": "CommonItem"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "desc": {
      "type": "text"
    },
    "label": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "actions": {
      "type": "component",
      "component": "item.button-item",
      "repeatable": true
    },
    "extend": {
      "type": "component",
      "component": "item.kv-item",
      "repeatable": true
    },
    "target_type": {
      "type": "enumeration",
      "default": "external_url",
      "enum": [
        "internal_url",
        "external_url",
        "popup"
      ]
    },
    "target_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "target_type"
            },
            "internal_url"
          ]
        }
      }
    },
    "target_url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "target_type"
            },
            "external_url"
          ]
        }
      }
    }
  },
  "config": {}
}
