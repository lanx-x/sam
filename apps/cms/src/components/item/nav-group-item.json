{
  "collectionName": "components_item_nav_group_items",
  "info": {
    "displayName": "NavNestItem"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "desc": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "LW Solutions",
        "Industries"
      ]
    },
    "children": {
      "type": "component",
      "component": "item.nav-basic-item",
      "repeatable": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "external"
            },
            false
          ]
        }
      }
    },
    "external_url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "external"
            },
            true
          ]
        }
      }
    },
    "external": {
      "type": "boolean",
      "default": false
    }
  },
  "config": {}
}
