{
  "collectionName": "components_item_nav_group_items",
  "info": {
    "displayName": "NavNestItem"
  },
  "options": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "desc": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "LW Solutions",
        "Industries"
      ]
    },
    "children": {
      "type": "component",
      "component": "item.nav-basic-item",
      "repeatable": true
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "target_type": {
      "type": "enumeration",
      "enum": [
        "internal_page",
        "external_url",
        "popup"
      ]
    },
    "target_page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "target_type"
            },
            "internal_page"
          ]
        }
      }
    },
    "external_url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "target_type"
            },
            "external_url"
          ]
        }
      }
    },
    "target_anchor": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "target_type"
            },
            "internal_page"
          ]
        }
      },
      "default": "#"
    },
    "alt_icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  },
  "config": {}
}
